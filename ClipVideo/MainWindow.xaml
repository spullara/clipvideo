<Window x:Class="ClipVideo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="ClipVideo - Video Clipper &amp; YouTube Uploader" 
        Height="700" Width="1000"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Video Clipper &amp; YouTube Uploader" 
                   Style="{StaticResource MaterialDesignHeadline4TextBlock}" 
                   Margin="0,0,0,20"/>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Video Preview -->
            <materialDesign:Card Grid.Column="0" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- File Selection -->
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Input Video" Style="{StaticResource MaterialDesignHeadline6TextBlock}" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="InputVideoPath" Grid.Column="0" Margin="0,0,10,0" 
                                     materialDesign:HintAssist.Hint="Select a video file..." IsReadOnly="True"/>
                            <Button x:Name="BrowseButton" Grid.Column="1" Content="BROWSE" Click="BrowseButton_Click"
                                    Style="{StaticResource MaterialDesignRaisedButton}"/>
                        </Grid>
                    </StackPanel>

                    <!-- Video Preview -->
                    <MediaElement x:Name="VideoPlayer" Grid.Row="1" Margin="0,20,0,0" 
                                  LoadedBehavior="Manual" ScrubbingEnabled="True"/>

                    <!-- Timeline Controls -->
                    <StackPanel Grid.Row="2" Margin="0,20,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PlayPauseButton" Grid.Column="0" Click="PlayPauseButton_Click"
                                    Style="{StaticResource MaterialDesignFloatingActionMiniButton}" Margin="0,0,10,0">
                                <materialDesign:PackIcon Kind="Play" Width="24" Height="24"/>
                            </Button>
                            <Slider x:Name="Timeline" Grid.Column="1" Minimum="0" Maximum="100" 
                                    ValueChanged="Timeline_ValueChanged" Margin="0,0,10,0"/>
                            <TextBlock x:Name="TimeDisplay" Grid.Column="2" VerticalAlignment="Center" 
                                       Text="00:00 / 00:00" MinWidth="100"/>
                        </Grid>

                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="SetStartButton" Grid.Column="0" Content="SET START TIME" 
                                    Click="SetStartButton_Click" Style="{StaticResource MaterialDesignOutlinedButton}"/>
                            <Button x:Name="SetEndButton" Grid.Column="2" Content="SET END TIME" 
                                    Click="SetEndButton_Click" Style="{StaticResource MaterialDesignOutlinedButton}"/>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Start:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="StartTimeText" Grid.Column="1" Margin="0,0,20,0" 
                                     materialDesign:HintAssist.Hint="00:00:00"/>
                            <TextBlock Grid.Column="2" Text="End:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="EndTimeText" Grid.Column="3" 
                                     materialDesign:HintAssist.Hint="00:00:00"/>
                        </Grid>

                        <Button x:Name="ClipButton" Content="CLIP VIDEO" Click="ClipButton_Click" 
                                Margin="0,20,0,0" Style="{StaticResource MaterialDesignRaisedButton}" Height="40"/>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <!-- Right Panel - YouTube Upload -->
            <materialDesign:Card Grid.Column="2" Padding="20">
                <StackPanel>
                    <TextBlock Text="YouTube Upload" Style="{StaticResource MaterialDesignHeadline6TextBlock}" Margin="0,0,0,20"/>
                    
                    <TextBox x:Name="VideoTitle" Margin="0,0,0,15"
                             materialDesign:HintAssist.Hint="Video Title*"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                    
                    <TextBox x:Name="VideoDescription" Margin="0,0,0,15"
                             materialDesign:HintAssist.Hint="Description"
                             TextWrapping="Wrap" AcceptsReturn="True" Height="100"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                    
                    <TextBox x:Name="VideoTags" Margin="0,0,0,15"
                             materialDesign:HintAssist.Hint="Tags (comma separated)"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                    
                    <ComboBox x:Name="PrivacyStatus" Margin="0,0,0,15"
                              materialDesign:HintAssist.Hint="Privacy Status"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}">
                        <ComboBoxItem Content="Private" IsSelected="True"/>
                        <ComboBoxItem Content="Public"/>
                        <ComboBoxItem Content="Unlisted"/>
                    </ComboBox>

                    <Button x:Name="AuthButton" Content="AUTHENTICATE WITH YOUTUBE" 
                            Click="AuthButton_Click" Margin="0,0,0,10"
                            Style="{StaticResource MaterialDesignOutlinedButton}"/>
                    
                    <Button x:Name="UploadButton" Content="UPLOAD TO YOUTUBE" 
                            Click="UploadButton_Click" IsEnabled="False"
                            Style="{StaticResource MaterialDesignRaisedButton}" Height="40"/>
                    
                    <ProgressBar x:Name="UploadProgress" Margin="0,20,0,10" 
                                 Minimum="0" Maximum="100" Value="0" Height="10"/>
                    <TextBlock x:Name="UploadStatus" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </materialDesign:Card>
        </Grid>

        <!-- Output Path -->
        <materialDesign:Card Grid.Row="2" Padding="15" Margin="0,20,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Output File:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="OutputVideoPath" Grid.Column="1" Margin="0,0,10,0" IsReadOnly="True"/>
                <Button x:Name="OpenOutputButton" Grid.Column="2" Content="OPEN FOLDER" 
                        Click="OpenOutputButton_Click" IsEnabled="False"/>
            </Grid>
        </materialDesign:Card>

        <!-- Status Bar -->
        <materialDesign:Card Grid.Row="3" Padding="10" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" Text="Ready" FontSize="12"/>
        </materialDesign:Card>
    </Grid>
</Window>
